{
  "name": "system-specification-tool",
  "version": "0.3.1",
  "type": "module",
  "bin": {
    "system-specification-tool": "bin/system-specification-tool.mjs"
  },
  "files": [
    "bin",
    "client",
    "public",
    "server",
    "shared",
    "index.html",
    "vite.config.ts"
  ],
  "scripts": {
    "dev": "tsx server/dev.ts --",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prestart": "npm run build",
    "start": "tsx server/index.ts",
    "test": "vitest run --reporter=default --exclude=test/guess-demo-node --reporter=json --outputFile=test/test-results/test-results.json && npm start -- --print --test-results ./test/test-results --project ./specification/System-Specification-Tool",
    "self": "npm run dev -- --project ./specification/System-Specification-Tool --test-results ./test/test-results"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "^5.0.2",
    "express": "^5.1.0",
    "multer": "^2.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.7",
    "tsx": "^4.20.5",
    "uuid": "^11.1.0",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.13",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
